# Example settings only. Copy to .env and never commit real values.
APP_NAME=alpha-backend
APP_ENV=local
LOG_LEVEL=INFO

# workflows run 상태 테이블 (SQLite 파일). 비워 두면 apps/backend/.data/workflows.sqlite3
# WORKFLOWS_DB_PATH=

# Do not put AWS / GCP / DB credentials here. Save them through
# PUT /db-migration/secrets/{run_id}/{tag}; they are stored encrypted (app/core/secrets.py).

# db_migration: CDC agent behind Cloudflare Access
CDC_AGENT_URL=
CDC_AGENT_ACCESS_CLIENT_ID=
CDC_AGENT_ACCESS_CLIENT_SECRET=

# db_migration: VPN. All required unless skip_vpn. Values come from infra/db_migration/terraform/oci
CDC_OCI_REGION=
CDC_OCI_COMPARTMENT_ID=
CDC_OCI_DRG_ID=
CDC_TFSTATE_BUCKET=
CDC_TFSTATE_NAMESPACE=
# vcn_cidr and subnet_cidr of that root. RDS admits only the node subnet.
CDC_OCI_VCN_CIDR=
CDC_NODE_SUBNET_CIDR=
# Optional. Default is the OCI tools' own default profile.
# CDC_OCI_PROFILE=

# db_migration: optional operating values, shown with their defaults (settings.py).
# CDC_REPL_USER=alpha_cdc_repl
# CDC_TARGET_DDL_USER=alpha_ddl
# CDC_TARGET_SINK_USER=alpha_sink
# CDC_DB_SSLMODE=require
# CDC_MAX_HOLD_MS=3000
# CDC_LOG_INTERVAL_S=10
# CDC_JOB_POLL_S=3
# CDC_PROBE_WAIT_S=180
# CDC_PROBE_RETRY_S=10
# CDC_COMPLETE_WAIT_S=1800
# CDC_COMPLETE_POLL_S=5
# CDC_CUTOVER_WAIT_S=60
# CDC_CUTOVER_POLL_S=1
# CDC_TERRAFORM_TIMEOUT_S=1800
# CDC_TUNNEL_WAIT_S=600
# CDC_TUNNEL_POLL_S=30
# CDC_AGENT_TIMEOUT_S=30
# CDC_AGENT_ABORT_TIMEOUT_S=95

# Local API access for /db-migration. Run the backend on 127.0.0.1 only.
# Optional fixed token. Default: a new token per launch, in api-token under the data folder (owner only).
# ALPHA_API_TOKEN=
# Optional Host header names, comma separated. Default: localhost,127.0.0.1,::1
# ALPHA_ALLOWED_HOSTS=

# Optional. Platform data folder (SQLite). Default is the OS app data folder.
# ALPHA_DATA_DIR=
# Optional. Key that encrypts secrets in SQLite. Default is the OS keychain.
# ALPHA_SECRETS_KEY=