# Example settings only. Copy to .env and never commit real values.
APP_NAME=alpha-backend
APP_ENV=local
LOG_LEVEL=INFO

# workflows run 상태 테이블 (SQLite 파일). 비워 두면 apps/backend/.data/workflows.sqlite3
# WORKFLOWS_DB_PATH=

# Do not put AWS / GCP / DB credentials here. Save them through
# PUT /db-migration/secrets/{run_id}/{tag}; they are stored encrypted (app/core/secrets.py).

# db_migration: CDC agent behind Cloudflare Access
CDC_AGENT_URL=
CDC_AGENT_ACCESS_CLIENT_ID=
CDC_AGENT_ACCESS_CLIENT_SECRET=

# db_migration: VPN. Values come from `terraform output` in infra/db_migration/terraform/oci
CDC_OCI_REGION=ap-singapore-1
CDC_OCI_PROFILE=DEFAULT
CDC_OCI_COMPARTMENT_ID=
CDC_OCI_DRG_ID=
CDC_TFSTATE_BUCKET=
CDC_TFSTATE_NAMESPACE=
# Local API access for /db-migration. Run the backend on 127.0.0.1 only.
# Optional fixed token. Default: a new token per launch, in api-token under the data folder (owner only).
# ALPHA_API_TOKEN=
# Optional Host header names, comma separated. Default: localhost,127.0.0.1,::1
# ALPHA_ALLOWED_HOSTS=

# Optional. Platform data folder (SQLite). Default is the OS app data folder.
# ALPHA_DATA_DIR=
# Optional. Key that encrypts secrets in SQLite. Default is the OS keychain.
# ALPHA_SECRETS_KEY=