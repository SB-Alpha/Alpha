# Example settings only. Copy to .env and never commit real values.
# Do not put AWS / GCP / DB credentials here. Save them through
# PUT /db-migration/secrets/{run_id}/{tag}; they are stored encrypted (app/core/secrets.py).

# ---------- Required: 12 fixed values ----------

# CDC agent behind Cloudflare Access. Values come from infra/db_migration/terraform/cloudflare
CDC_AGENT_URL=
CDC_AGENT_ACCESS_CLIENT_ID=
CDC_AGENT_ACCESS_CLIENT_SECRET=

# OCI for the VPN. Not read when skip_vpn is set. Values come from infra/db_migration/terraform/oci
CDC_OCI_REGION=
CDC_OCI_COMPARTMENT_ID=
CDC_OCI_DRG_ID=
# vcn_cidr and subnet_cidr of that root. RDS admits only the node subnet.
CDC_OCI_VCN_CIDR=
CDC_NODE_SUBNET_CIDR=
CDC_TFSTATE_BUCKET=
CDC_TFSTATE_NAMESPACE=

# Traffic switch. Cloudflare Worker control address and a file holding its control token
WORKER_URL=
WORKER_TOKEN_FILE=

# ---------- Optional: leave empty to use the default ----------

# APP_NAME=alpha-backend
# APP_ENV=local
# LOG_LEVEL=INFO

# workflows run 상태 테이블 (SQLite 파일). 비워 두면 apps/backend/.data/workflows.sqlite3
# WORKFLOWS_DB_PATH=

# Default is the OCI tools' own default profile.
# CDC_OCI_PROFILE=

# db_migration: operating values, shown with their defaults (settings.py).
# CDC_REPL_USER=alpha_cdc_repl
# CDC_TARGET_DDL_USER=alpha_ddl
# CDC_TARGET_SINK_USER=alpha_sink
# CDC_DB_SSLMODE=require
# CDC_MAX_HOLD_MS=3000
# CDC_LOG_INTERVAL_S=10
# CDC_JOB_POLL_S=3
# CDC_PROBE_WAIT_S=180
# CDC_PROBE_RETRY_S=10
# CDC_COMPLETE_WAIT_S=1800
# CDC_COMPLETE_POLL_S=5
# CDC_CUTOVER_WAIT_S=60
# CDC_CUTOVER_POLL_S=1
# CDC_TERRAFORM_TIMEOUT_S=3600
# CDC_TUNNEL_WAIT_S=600
# CDC_TUNNEL_POLL_S=30
# CDC_AGENT_TIMEOUT_S=30
# CDC_AGENT_ABORT_TIMEOUT_S=95

# Local API access for /db-migration. Run the backend on 127.0.0.1 only.
# Host header names, comma separated. Default: localhost,127.0.0.1,::1
# ALPHA_ALLOWED_HOSTS=
# Page addresses that may call it, comma separated. Set this when the screen runs on another port.
# Default: http://localhost:3000,http://127.0.0.1:3000,http://[::1]:3000
# ALPHA_ALLOWED_ORIGINS=

# Platform data folder (SQLite). Default is the OS app data folder.
# ALPHA_DATA_DIR=
# Key that encrypts secrets in SQLite. Default is the OS keychain.
# ALPHA_SECRETS_KEY=
# 전환 중 실패 수를 실측할 Worker 공개 주소. 비우면 화면은 미제공
# ALPHA_PROBE_URL=
# 전환 전 점검의 복제 지연 기준(바이트). 합의된 값이 없어 기본값이 없습니다. 비우면 참고용으로만 표시
# ALPHA_CUTOVER_MAX_LAG_BYTES=
